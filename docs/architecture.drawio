<diagram id="d1" name="Architecture L2">
<mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
<root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="p" value="&lt;b&gt;LỚP TRÌNH BÀY — Presentation&lt;/b&gt;&lt;br/&gt;TicketController&lt;br/&gt;TicketListView · TicketFormView&lt;br/&gt;&lt;br/&gt;&lt;i&gt;Nhận input, hiển thị kết quả; không chứa business rule/SQL.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="80" y="90" width="360" height="180" as="geometry"/></mxCell>
<mxCell id="b" value="&lt;b&gt;LỚP NGHIỆP VỤ — Business / Service&lt;/b&gt;&lt;br/&gt;TicketService&lt;br/&gt;ClassificationService&lt;br/&gt;&lt;br/&gt;&lt;i&gt;Toàn bộ quy tắc nghiệp vụ: bắt buộc dữ liệu, phân loại, priority, hạn xử lý.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="520" y="90" width="360" height="180" as="geometry"/></mxCell>
<mxCell id="r" value="&lt;b&gt;LỚP TRUY CẬP DỮ LIỆU — Repository / DAO&lt;/b&gt;&lt;br/&gt;TicketRepository&lt;br/&gt;CustomerRepository · DeviceRepository · StatusLogRepository&lt;br/&gt;&lt;br/&gt;&lt;i&gt;Đọc/ghi dữ liệu; che giấu SQL; không chứa business rule.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="960" y="90" width="420" height="180" as="geometry"/></mxCell>
<mxCell id="d" value="&lt;b&gt;LỚP LƯU TRỮ — SQLite&lt;/b&gt;&lt;br/&gt;customer · device · issue_category · ticket · ticket_status_log&lt;br/&gt;&lt;br/&gt;&lt;i&gt;PK/FK/NOT NULL/UNIQUE/CHECK/INDEX.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="520" y="390" width="360" height="150" as="geometry"/></mxCell>
<mxCell id="out" value="&lt;b&gt;NGOÀI PHẠM VI (WON&#x27;T)&lt;/b&gt;&lt;br/&gt;• Phân công kỹ thuật viên&lt;br/&gt;• Sửa chữa thiết bị&lt;br/&gt;• Thanh toán/thu phí&lt;br/&gt;• SMS/Email tự động&lt;br/&gt;• Quản lý kho linh kiện" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1020" y="390" width="360" height="190" as="geometry"/></mxCell>
<mxCell id="note" value="&lt;b&gt;CHÚ THÍCH&lt;/b&gt;&lt;br/&gt;→ phụ thuộc một chiều từ lớp trên xuống lớp dưới&lt;br/&gt;HTTP + JSON giữa Browser ↔ Presentation/API&lt;br/&gt;Interface Repository giữa Business ↔ Data Access&lt;br/&gt;SQL giữa Repository/DAO ↔ SQLite" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="80" y="390" width="360" height="170" as="geometry"/></mxCell>
<mxCell id="e1" value="HTTP + JSON" style="endArrow=block;html=1;strokeWidth=1.5;" edge="1" parent="1" source="p" target="b"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e2" value="Repository interface" style="endArrow=block;html=1;strokeWidth=1.5;" edge="1" parent="1" source="b" target="r"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e3" value="SQL" style="endArrow=block;html=1;strokeWidth=1.5;" edge="1" parent="1" source="r" target="d"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="flow" value="&lt;b&gt;Đường đi ví dụ: Tạo phiếu&lt;/b&gt;&lt;br/&gt;TicketController → TicketService.create() → TicketRepository.save() → INSERT ticket + ticket_status_log&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Ngoại lệ:&lt;/b&gt; Business phát hiện thiết bị hết hạn → trả lỗi nghiệp vụ → Controller ánh xạ HTTP 422 → View hiển thị lỗi." style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="80" y="650" width="1300" height="150" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>